/target

# Reviewer-tuning notes, corpus and measurements — kept out of the public crate.
# The whole directory, not a list of paths: it is its own PRIVATE repo
# (nhatvu148/pr-review-docs) and contains client-confidential material, so a new
# file added there must never reach this public repo by default.
docs/

# Distribution build outputs (packaging/). The platform packages hold the actual
# binaries — hundreds of MB — and are rebuilt from CI artifacts on every release.
packaging/npm/platforms/
packaging/pypi/wheels/
packaging/**/node_modules/
__pycache__/
